<?xml version="1.0" encoding="utf-8"?>
<skin>
	<information>
		<name>DDSWindowSkin</name>
		<version>1.2.2</version>
		<license>
			<![CDATA[개인사용 / 금지사항: 재배포, 출처삭제]]>
		</license>
	</information>

	<author>
		<name>돌딤섬</name>
		<homepage>https://doldimseom.tistory.com/21</homepage>
		<email></email>
	</author>

	<variables>
		<variablegroup name="기본 저장소 설정">
			<variable>
				<name>noteStorage</name>
				<label><![CDATA[※]]></label>
				<type>STRING</type>
				<default><![CDATA[기본 저장소를 설정합니다. 지정한 저장소(포스트/카테고리)가 갤러리, 디데이 등으로 반영됩니다. 블로그에서 자유롭게 꾸민 뒤 슬롯으로 저장하면 됩니다.]]></default>
			</variable>
			<variable>
				<name>configPostUrl</name>
				<label><![CDATA[슬롯 저장 포스트 (/번호)]]></label>
				<type>STRING</type>
				<default><![CDATA[]]></default>
			</variable>

			<variable>
				<name>calendarPostUrl</name>
				<label><![CDATA[캘린더 포스트 (/번호 — 본문 한 줄당 "YYYY-MM-DD 내용" 형식, 비우면 기록 없이 표시)]]></label>
				<type>STRING</type>
				<default><![CDATA[]]></default>
			</variable>

			<variable>
				<name>noteGallery</name>
				<label><![CDATA[※]]></label>
				<type>STRING</type>
				<default><![CDATA[배경화면·스티커·쉐이커·투두에 사용하는 모든 이미지는 갤러리에서 가져옵니다. 카테고리 여러 개 지정 가능 (쉼표로 구분) / 하위 카테고리는 "상위/하위"로 적습니다 (예: 여행/사진)]]></default>
			</variable>

			<variable>
				<name>galleryCategories</name>
				<label><![CDATA[갤러리 카테고리 (하위는 상위/하위)]]></label>
				<type>STRING</type>
				<default><![CDATA[]]></default>
			</variable>

			<variable>
				<name>ddayCategory</name>
				<label><![CDATA[디데이 카테고리 (하위는 상위/하위)]]></label>
				<type>STRING</type>
				<default><![CDATA[디데이]]></default>
			</variable>

		</variablegroup>

		<variablegroup name="로딩 화면 설정">
			<variable>

				<name>loadingBg</name>
				<label><![CDATA[로딩 화면 배경색]]></label>
				<type>COLOR</type>
				<default><![CDATA[#dcdcd8]]></default>
			</variable>
			<variable>
				<name>loadingLogoText</name>
				<label><![CDATA[로고 텍스트 (공란일 경우 블로그명 표시)]]></label>
				<type>STRING</type>
				<default><![CDATA[]]></default>
			</variable>
			<variable>
				<name>loadingLogoImage</name>
				<label><![CDATA[로고 이미지]]></label>
				<type>IMAGE</type>
				<default><![CDATA[]]></default>
			</variable>
			<variable>
				<name>loadingCaption</name>
				<label><![CDATA[로딩 문구 (진행바 아래 — 비우면 표시 안 함)]]></label>
				<type>STRING</type>
				<default><![CDATA[Now Loading...]]></default>
			</variable>
		</variablegroup>

		<variablegroup name="사운드 설정">
			<variable>
				<name>clickSound</name>
				<label><![CDATA[클릭음 사용]]></label>
				<type>BOOL</type>
				<default><![CDATA[true]]></default>
			</variable>
			<variable>
				<name>shakerSound</name>
				<label><![CDATA[쉐이커 사운드 사용]]></label>
				<type>BOOL</type>
				<default><![CDATA[true]]></default>
			</variable>
		</variablegroup>

		<variablegroup name="기타 설정">
			<variable>
				<name>windowMotion</name>
				<label><![CDATA[창·메뉴 모션 사용 (끄면 창·시작 메뉴·이미지 뷰어가 모션 없이 즉시 나타납니다. 스티커 등 꾸미기 모션은 켜진 채로 남습니다)]]></label>
				<type>BOOL</type>
				<default><![CDATA[true]]></default>
			</variable>
			<variable>
				<name>postSerifFont</name>
				<label><![CDATA[본문 명조체 사용 (게시글 본문을 Noto Serif KR로 표시 — 끄면 프리텐다드)]]></label>
				<type>BOOL</type>
				<default><![CDATA[false]]></default>
			</variable>
			<variable>
				<name>pixelCursor</name>
				<label><![CDATA[픽셀 커서 사용 (끄면 브라우저 기본 커서 — 슬롯 커서 지정도 무시)]]></label>
				<type>BOOL</type>
				<default><![CDATA[true]]></default>
			</variable>
			<variable>
				<name>categoryTreeExpanded</name>
				<label><![CDATA[게시글 창 폴더 트리에서 하위 카테고리 펼쳐 두기 (끄면 접힌 상태로 시작)]]></label>
				<type>BOOL</type>
				<default><![CDATA[true]]></default>
			</variable>

			<variable>
				<name>visitorEditing</name>
				<label><![CDATA[방문자 꾸미기 허용 (기본 꺼짐 = 열람만 — 켜면 스티커·위젯 꾸밈까지 바꿀 수 있습니다)]]></label>
				<type>BOOL</type>
				<default><![CDATA[false]]></default>
			</variable>

		</variablegroup>
	</variables>

	<liststyle>
		<item>
			<label><![CDATA[갤러리형]]></label>
			<value>gallery</value>
		</item>
		<item>
			<label><![CDATA[목록형]]></label>
			<value>list</value>
		</item>
	</liststyle>

	<default>
		<liststyle>gallery</liststyle>
		<recentEntries>10</recentEntries>
		<recentComments>5</recentComments>
		<recentTrackbacks>5</recentTrackbacks>
		<itemsOnGuestbook>10</itemsOnGuestbook>
		<tagsInCloud>30</tagsInCloud>
		<sortInCloud>1</sortInCloud>
		<expandComment>1</expandComment>
		<expandTrackback>0</expandTrackback>
		<lengthOfRecentNotice>25</lengthOfRecentNotice>
		<lengthOfRecentEntry>27</lengthOfRecentEntry>
		<lengthOfRecentComment>30</lengthOfRecentComment>
		<lengthOfRecentTrackback>30</lengthOfRecentTrackback>
		<lengthOfLink>30</lengthOfLink>
		<showListOnCategory>1</showListOnCategory>
		<showListOnArchive>1</showListOnArchive>
		<contentWidth>900</contentWidth>
	</default>
</skin>
